#!/bin/sh
# Launch wlsunset with latitude/longitude from GeoClue.
# Starts instantly with the last known location (if any), then looks up the
# current location and restarts wlsunset only if it has moved noticeably.
# Exits if there is neither a cached nor a fresh location.
# Extra arguments are passed through to wlsunset (e.g. -t 4500).

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/wlsunset-location"
DEMOS=/usr/lib/geoclue-2.0/demos

# Print "LAT LON" from GeoClue, or nothing if no location within 30 seconds.
lookup() {
  # GeoClue won't answer clients unless an agent is running.
  if ! pgrep -u "$(id -u)" -f "$DEMOS/agent" >/dev/null; then
    setsid -f "$DEMOS/agent" >/dev/null 2>&1
    sleep 1
  fi

  # Run where-am-i in the background and stop it as soon as a location arrives.
  out=$(mktemp)
  LC_ALL=C stdbuf -oL "$DEMOS/where-am-i" -t 30 >"$out" 2>/dev/null &
  pid=$!

  while kill -0 "$pid" 2>/dev/null &&
    ! grep -q '^Longitude:' "$out"; do
    sleep 1
  done

  kill "$pid" 2>/dev/null

  awk '/^Latitude:/ {lat=$2} /^Longitude:/ {print lat, $2; exit}' "$out" |
    tr -d '°'

  rm -f "$out"
}

# True if two "LAT LON" pairs differ by more than 0.1° (~10 km).
moved() {
  echo "$1 $2" | awk '{
    d1 = $1 - $3; d2 = $2 - $4
    exit !(d1 > 0.1 || d1 < -0.1 || d2 > 0.1 || d2 < -0.1)
  }'
}

cached=$(cat "$CACHE" 2>/dev/null)

# Start immediately with the cached location.
if [ -n "$cached" ]; then
  wlsunset -l "${cached% *}" -L "${cached#* }" "$@" &
  wpid=$!
fi

loc=$(lookup)

if [ -z "$loc" ]; then
  [ -n "$cached" ] && exit 0
  echo "wlsunset-geo: no location from GeoClue and no cached location" >&2
  exit 1
fi

mkdir -p "$(dirname "$CACHE")"
printf '%s\n' "$loc" >"$CACHE"

if [ -z "$cached" ] || moved "$cached" "$loc"; then
  [ -n "$wpid" ] && kill "$wpid" 2>/dev/null
  exec wlsunset -l "${loc% *}" -L "${loc#* }" "$@"
fi
